# ============================================================
# GeoLeads Pro Configuration
# ============================================================

# Master Superuser Key (Unlocks unlimited searches, AI pitches & CRM)
GEOLEADS_MASTER_KEY=geoleads-pro-2026

# Lead Quotas
COMMUNITY_MAX_LEADS=25
PRO_MAX_LEADS=500

# AI Provider: 'template' (Zero cost, offline), 'gemini', 'openai', or 'ollama'
GEOLEADS_AI_PROVIDER=template

# Optional AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Database Path (Default is local SQLite)
GEOLEADS_DB_FILE=./geoleads.db

# Crawler Settings
CRAWLER_TIMEOUT=8

# GitHub Star-Gate Repository URL
GITHUB_REPO_URL=https://github.com/geoleads/geoleads
